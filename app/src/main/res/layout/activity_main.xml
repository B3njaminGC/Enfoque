<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Barra superior: flash · resumen · ajustes -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Flash"
            android:padding="11dp"
            android:src="@drawable/ic_flash_off" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="12MP · 4:3"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/statusChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/white" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Ajustes"
            android:padding="11dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Visor -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Modo VOZ -->
    <LinearLayout
        android:id="@+id/voicePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF0D0D10"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_voice"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/voiceTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="68sp" />

        <TextView
            android:id="@+id/voiceHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="Grabá la voz de tus Shorts y videos.\nSe guarda en Música/Enfoque."
            android:textColor="@color/dim"
            android:textSize="14sp" />
    </LinearLayout>

    <com.enfoque.camara.GridOverlay
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.enfoque.camara.LevelOverlay
        android:id="@+id/levelOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.enfoque.camara.FocusRingView
        android:id="@+id/focusRing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.enfoque.camara.GuideOverlay
        android:id="@+id/guideOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.enfoque.camara.PrompterView
        android:id="@+id/prompter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/flashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.enfoque.camara.HistogramView
        android:id="@+id/histogram"
        android:layout_width="120dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <TextView
        android:id="@+id/recBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <TextView
        android:id="@+id/infoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_info"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:shadowColor="#FF000000"
        android:shadowRadius="14"
        android:textColor="@color/white"
        android:textSize="110sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <!-- Panel inferior -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_fade"
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.enfoque.camara.AudioMeterView
            android:id="@+id/audioMeter"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Exposición rápida (aparece al tocar para enfocar) -->
        <LinearLayout
            android:id="@+id/evRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/evLabel"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="EV +0.0"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/evSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="10"
                app:labelBehavior="gone" />
        </LinearLayout>

        <!-- Modo PRO -->
        <LinearLayout
            android:id="@+id/proPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="14dp">

                <TextView android:id="@+id/btnProAuto" style="@style/Chip" android:text="AUTO" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/proSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="1"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="10"
                    app:labelBehavior="gone" />

                <TextView
                    android:id="@+id/proValue"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView android:id="@+id/chipIso" style="@style/ProChip" android:text="ISO" />
                    <TextView android:id="@+id/chipShutter" style="@style/ProChip" android:text="VEL." />
                    <TextView android:id="@+id/chipFocus" style="@style/ProChip" android:text="ENFOQUE" />
                    <TextView android:id="@+id/chipWb" style="@style/ProChip" android:text="BLANCOS" />
                    <TextView android:id="@+id/chipEv" style="@style/ProChip" android:text="EV" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Lentes / zoom en cápsula -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <LinearLayout
                android:id="@+id/zoomRow"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="3dp" />
        </FrameLayout>

        <!-- Modos -->
        <LinearLayout
            android:id="@+id/modeRow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/modePhoto" style="@style/ModeText" android:text="FOTO" />
            <TextView android:id="@+id/modePro" style="@style/ModeText" android:text="PRO" />
            <TextView android:id="@+id/modeYoutube" style="@style/ModeText" android:text="YOUTUBE" />
            <TextView android:id="@+id/modeShorts" style="@style/ModeText" android:text="SHORTS" />
            <TextView android:id="@+id/modeVoice" style="@style/ModeText" android:text="VOZ" />
        </LinearLayout>

        <!-- Controles -->
        <FrameLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="112dp">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="36dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="Última foto o video"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/pauseButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="36dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Pausa"
                android:padding="16dp"
                android:src="@drawable/ic_pause"
                android:visibility="gone" />

            <com.enfoque.camara.ShutterButton
                android:id="@+id/shutterButton"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/flipButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="36dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Cambiar cámara"
                android:padding="14dp"
                android:src="@drawable/ic_flip" />
        </FrameLayout>
    </LinearLayout>

    <!-- Accesos rápidos (se despliega al tocar el resumen de arriba) -->
    <LinearLayout
        android:id="@+id/quickPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />
</androidx.constraintlayout.widget.ConstraintLayout>
